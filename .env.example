# Copy to .env and fill in. Never commit .env.
# Free route: an open model on Jetstream2 (token from the Jetstream chat UI),
# with Tavily for the web search the model cannot do itself.
JETSTREAM_API_KEY=
TAVILY_API_KEY=
# Optional: defaults to gpt-oss-120b
# JETSTREAM_MODEL=gpt-oss-120b
# Paid route, used when JETSTREAM_API_KEY is empty: OpenAI with its web search tool.
OPENAI_API_KEY=
# Optional: defaults to gpt-5
MODEL=gpt-5
# Optional: how many example groups from the CSV go into the prompt
EXAMPLE_ROWS=12
