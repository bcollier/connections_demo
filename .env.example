# Copy to .env and fill in. Never commit .env. On Vercel, set these in the
# project's environment variables instead.

# The puzzle writer. One OpenRouter key reaches every commercial model (billed
# per call). A Jetstream2 key adds the free open models on the academic
# allocation (gpt-oss-120b, muse-glimmer, gemma, qwen), listed on the admin page
# as jetstream/<model>. Either key is enough for live puzzles.
OPENROUTER_API_KEY=
JETSTREAM_API_KEY=
# JETSTREAM_BASE_URL=https://llm.jetstream-cloud.org/api
# Which model writes puzzles until an admin changes it: an OpenRouter model id,
# or jetstream/<model> for a free one.
DEFAULT_MODEL=anthropic/claude-opus-5.5

# The admin page (/admin.html) asks for this to change the model or the daily cap.
# Make a new one for this project: openssl rand -hex 16
ADMIN_PASSWORD=

# Supabase: where every generated game is kept (its words, groups, stories and
# links) and where the admin's model choice persists. Create the two tables with
# supabase/001_cx.sql. Without these the game still runs, but nothing is saved.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The New York Times Top Stories API (free key at developer.nytimes.com)
# gives real abstracts instead of the RSS one-liners.
NYT_API_KEY=

# Optional brakes. Newsroom time zone decides when "today's paper" turns over.
# DAILY_CAP=150
# NEWS_TZ=America/New_York
# PER_IP_WINDOW=6
# PER_IP_DAY=20
# MAX_IN_FLIGHT=3
# ALLOWED_ORIGINS=https://example.com
